{%- comment -%}
  Press detail body: a single clipping image, or a justified gallery.
  Params: mode (single|gallery), top_offset, image_width_percent, image_width_px, image_height_px, row_height, images (array)
{%- endcomment -%}
{{ 'section-amesh-project.css' | asset_url | stylesheet_tag }}

<div class="amesh-press-detail" data-amesh-project style="--amesh-press-top: {{ top_offset | default: 0 }}px;">
  {%- if mode == 'single' -%}
    <div class="amesh-press-detail__single">
      {%- assign image = images | first | strip -%}
      <img
        src="{{ image | asset_url }}"
        alt=""
        style="{% if image_width_px > 0 %}width: {{ image_width_px }}px;{% elsif image_width_percent > 0 %}width: {{ image_width_percent }}%;{% else %}width: auto;{% endif %}{% if image_height_px > 0 %} height: {{ image_height_px }}px;{% else %} height: auto;{% endif %}"
      >
    </div>
  {%- else -%}
    <div class="amesh-project__gallery amesh-press-detail__gallery" data-gallery data-ideal="{{ row_height | default: 800 }}" data-ideal-tablet="500" data-ideal-mobile="{{ row_height_mobile | default: 300 }}" data-gap="0">
      {%- for image in images -%}
        {%- assign file = image | strip -%}
        {%- if file != blank -%}
          <a class="amesh-project__item" href="{{ file | asset_url }}">
            <img src="{{ file | asset_url }}" alt="" decoding="async">
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script src="{{ 'section-amesh-project.js' | asset_url }}" defer></script>
