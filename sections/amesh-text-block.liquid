{{ 'section-amesh-text-block.css' | asset_url | stylesheet_tag }}

<section class="amesh-text-block">
  <div class="amesh-text-block__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="amesh-text-block__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="amesh-text-block__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AMESH text block",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "AMESH text block" }]
}
{% endschema %}
