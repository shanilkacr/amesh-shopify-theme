{{ 'section-amesh-press-grid.css' | asset_url | stylesheet_tag }}

<div class="amesh-press-grid" style="--amesh-press-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  {%- for col in (1..5) -%}
    {%- assign col_key = col | append: '' -%}
    <div class="amesh-press-grid__column">
      {%- for block in section.blocks -%}
        {%- if block.settings.column == col_key -%}
          {%- assign link = block.settings.link -%}
          <{% if link != blank %}a href="{{ link }}"{% if link contains 'http' %} target="_blank" rel="noopener"{% endif %}{% else %}div{% endif %}
            class="amesh-press-grid__tile"
            style="--amesh-press-height: {{ block.settings.tile_height }}px; background-image: url({{ block.settings.image_filename | asset_url }});"
            {{ block.shopify_attributes }}
          ><span class="amesh-press-grid__veil" aria-hidden="true"></span></{% if link != blank %}a{% else %}div{% endif %}>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "AMESH press grid",
  "max_blocks": 50,
  "settings": [
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Dark overlay",
      "info": "Fades out on hover",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Press tile",
      "settings": [
        { "type": "text", "id": "image_filename", "label": "Image asset filename" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "options": [
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" },
            { "value": "5", "label": "5" }
          ],
          "default": "1"
        },
        {
          "type": "select",
          "id": "tile_height",
          "label": "Tile height",
          "options": [
            { "value": "270", "label": "Short (270px)" },
            { "value": "450", "label": "Medium (450px)" },
            { "value": "540", "label": "Tall (540px)" }
          ],
          "default": "270"
        }
      ]
    }
  ],
  "presets": [{ "name": "AMESH press grid" }]
}
{% endschema %}
