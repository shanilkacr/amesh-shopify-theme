{{ 'section-amesh-hero-video.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@600&display=swap">

<div class="amesh-hero amesh-hero-{{ section.id }}" data-amesh-hero>
  <div class="amesh-hero__scroll-area">
    <div class="amesh-hero__video-wrapper">
      <video
        class="amesh-hero__video"
        data-amesh-hero-video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        crossorigin="anonymous"
      >
        <source src="{{ 'amesh-hero-video.webm' | asset_url }}" type="video/webm">
      </video>
    </div>
    <div class="amesh-hero__sticky-wrap">
      <h1 class="visually-hidden">{{ section.settings.heading }}</h1>
      <canvas
        class="amesh-hero__overlay-canvas"
        data-amesh-hero-canvas
        data-heading="{{ section.settings.heading | escape }}"
        aria-hidden="true"
      ></canvas>
    </div>
  </div>
  {%- if section.settings.tagline != blank -%}
    <p class="amesh-hero__tagline">{{ section.settings.tagline }}</p>
  {%- endif -%}
</div>

<script src="{{ 'amesh-hero-video.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "AMESH hero video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AMESH"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "A Celebration of Colour, Culture, Community and Craftsmanship"
    }
  ],
  "presets": [
    {
      "name": "AMESH hero video"
    }
  ]
}
{% endschema %}
