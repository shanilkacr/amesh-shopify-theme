{{ 'section-amesh-hero-video.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .amesh-hero-{{ section.id }} .amesh-hero__overlay-text {
    color: {{ section.settings.overlay_text_color }};
    mix-blend-mode: {{ section.settings.overlay_blend_mode }};
  }
{%- endstyle -%}

<div class="amesh-hero amesh-hero-{{ section.id }}">
  <div class="amesh-hero__scroll-area">
    <div class="amesh-hero__video-wrapper">
      <video
        class="amesh-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
        <source src="{{ 'amesh-hero-video.webm' | asset_url }}" type="video/webm">
      </video>
    </div>
    <div class="amesh-hero__sticky-wrap">
      <span class="amesh-hero__overlay-text">{{ section.settings.heading }}</span>
    </div>
  </div>
  <h1 class="amesh-hero__heading text-accent-red">{{ section.settings.heading }}</h1>
  {%- if section.settings.tagline != blank -%}
    <p class="amesh-hero__tagline">{{ section.settings.tagline }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "AMESH hero video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AMESH"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "A Celebration of Colour, Culture, Community and Craftsmanship"
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Overlay text color",
      "info": "Solid color that blends into the video via the blend mode below — the blended look comes from the blend mode, not a gradient",
      "default": "#67FFFF"
    },
    {
      "type": "select",
      "id": "overlay_blend_mode",
      "label": "Overlay text blend mode",
      "info": "Controls how the flat-colored heading blends with the video behind it",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "multiply", "label": "Multiply" },
        { "value": "screen", "label": "Screen" },
        { "value": "overlay", "label": "Overlay" },
        { "value": "darken", "label": "Darken" },
        { "value": "lighten", "label": "Lighten" },
        { "value": "color-dodge", "label": "Color dodge" },
        { "value": "color-burn", "label": "Color burn" },
        { "value": "hard-light", "label": "Hard light" },
        { "value": "soft-light", "label": "Soft light" },
        { "value": "difference", "label": "Difference" },
        { "value": "exclusion", "label": "Exclusion" },
        { "value": "hue", "label": "Hue" },
        { "value": "saturation", "label": "Saturation" },
        { "value": "color", "label": "Color" },
        { "value": "luminosity", "label": "Luminosity" }
      ],
      "default": "color"
    }
  ],
  "presets": [
    {
      "name": "AMESH hero video"
    }
  ]
}
{% endschema %}
