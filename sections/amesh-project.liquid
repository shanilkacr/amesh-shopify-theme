{{ 'section-amesh-project.css' | asset_url | stylesheet_tag }}

<div class="amesh-project" data-amesh-project>
  <div
    class="amesh-project__hero"
    style="{% if section.settings.poster_filename != blank %}background-image: url({{ section.settings.poster_filename | asset_url }});{% endif %} background-position: {{ section.settings.poster_position | default: 'center center' }};"
  >
    {%- if section.settings.video_filename != blank -%}
      <video
        class="amesh-project__video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        {% if section.settings.video_start > 0 %}data-start="{{ section.settings.video_start }}"{% endif %}
        {% if section.settings.video_end > 0 %}data-end="{{ section.settings.video_end }}"{% endif %}
      >
        <source src="{{ section.settings.video_filename | asset_url }}" type="video/webm">
      </video>
    {%- endif -%}
  </div>

  <div class="amesh-project__text">
    <h1 class="amesh-project__heading">{{ section.settings.heading }}</h1>
    <div class="amesh-project__copy{% if section.settings.flush_text %} amesh-project__copy--flush{% endif %}">{{ section.settings.text }}</div>
  </div>

  <div class="amesh-project__gallery" data-gallery>
    {%- for block in section.blocks -%}
      <a
        class="amesh-project__item"
        href="{{ block.settings.image_filename | asset_url }}"
        {{ block.shopify_attributes }}
      >
        <img src="{{ block.settings.image_filename | asset_url }}" alt="" decoding="async">
      </a>
    {%- endfor -%}
  </div>
</div>

<script src="{{ 'section-amesh-project.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "AMESH project",
  "settings": [
    { "type": "text", "id": "video_filename", "label": "Hero video asset filename" },
    { "type": "number", "id": "video_start", "label": "Video loop start (seconds)" },
    { "type": "number", "id": "video_end", "label": "Video loop end (seconds)" },
    { "type": "text", "id": "poster_filename", "label": "Hero image asset filename" },
    { "type": "text", "id": "poster_position", "label": "Hero image position", "default": "center center" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "flush_text", "label": "No paragraph bottom margin", "default": false }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        { "type": "text", "id": "image_filename", "label": "Image asset filename" }
      ]
    }
  ],
  "presets": [
    { "name": "AMESH project" }
  ]
}
{% endschema %}
